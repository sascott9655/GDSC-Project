#how variance each PC contributes
exp_var <- (data_num_pca$sdev^2) / sum(data_num_pca$sdev^2)
exp_var
#cumulatively adds how much each PC contributes till the value 1 is reached
data_ex_vratio <- cumsum(exp_var)
data_ex_vratio
par(pty = "s") #generate a square plot region s for square
plot(
exp_var,
type = "b", #draw both lines and points
pch = 19, #use solid circles for the points
xlab = "Principal Component",
ylab = "Explained Variance Ratio",
main = "Scree Plot"
)
abs(data_num_pca$rotation[,1])
sort(abs(data_num_pca$rotation[,1]), decreasing = TRUE)
biplot(data_num_pca)
PC1 <- data_num_pca$x[,1]
cor.test(PC1, data_c$LN_IC50) #show PC 1 confidence interval roughly between 0.746 and 0.750
plot(
PC1,
data_c$LN_IC50,
pch = 19,
xlab = "PC1",
ylab = "LN_IC50",
main = "PC1 vs LN_IC50"
)
abline(lm(data_c$LN_IC50 ~ PC1), col = "red")
# the final cleaned, reduced, and transformed data set is data_f.
data_f <- data_c %>% select(-AUC)
str(data_f)
data_f <- data_f %>% select(-CELL_LINE_NAME, -DRUG_NAME)
seed <- 756
set.seed(seed)
#Target variable
IC50 <- data_f$LN_IC50
#Predictors
data_f <- as.data.frame(data_f)
row_reduction <- 0.10
#Get 10 percent of the data amount randomly
rrow_count <- sample(nrow(data_f), size=floor(row_reduction*nrow(data_f)))
#Reduced the the amount of observations for modeling
data_f <- data_f[rrow_count, ]
IC50 <- IC50[rrow_count]
#Encoding TARGET variables
target_encode <- model.matrix(~ TARGET - 1, data = data_f)
#Encoding the TARGET_PATHWAY variables
pathway_encode <- model.matrix(~ TARGET_PATHWAY - 1, data = data_f)
#Encoding TCGA_DESC
tissue_encode <- dummyVars(~ TCGA_DESC, data = data_f)
tissue_encode <- predict(tissue_encode, data_f)
#Encoding GDSC Tissue Descriptor 2
gdsctd2_encode <- dummyVars(~ GDSC.Tissue.descriptor.2, data = data_f)
gdsctd2_encode <- predict(gdsctd2_encode, data_f)
#Since only 3 types in predictor we can make it discrete numeric
data_f$MSI <- as.numeric(as.factor(data_f$Microsatellite.instability.Status..MSI.))
predictors <- cbind(
target_encode,
pathway_encode,
tissue_encode,
gdsctd2_encode,
MSI = data_f$MSI,
Z_SCORE = data_f$Z_SCORE
)
predictors <- as.data.frame(predictors)
trainingRows <- createDataPartition(IC50, p =.8, list=FALSE)
trainPredictors <- predictors[trainingRows,]
testPredictors <- predictors[-trainingRows,]
trainIC50 <- IC50[trainingRows]
testIC50 <- IC50[-trainingRows]
#Get rid of variables that are zero variance...
nzv <- nearZeroVar(trainPredictors)
trainPredictors <- trainPredictors[, -nzv]
testPredictors  <- testPredictors[, -nzv]
#...and highly correlated
correlations <- cor(trainPredictors)
highCorr <- findCorrelation(correlations, cutoff = 0.75)
trainPredictors <- trainPredictors[, -highCorr]
testPredictors  <- testPredictors[, -highCorr] # Remove same columns
colnames(trainPredictors)
#Before model training we need to use parallel processing so the CPU can run models more quickly
num_cores <- detectCores() - 1             # Leave 1 core for background tasks
cl <- makeCluster(num_cores)
registerDoParallel(cl)
set.seed(seed)
#Set up cross validation
fivefoldCV <- trainControl(method = "cv", number = 5, allowParallel = TRUE)
#repeatedSplits <- trainControl(method = "repeatedcv", number = 5, repeats = 3, allowParallel = TRUE)
#Sanity Check
dim(trainPredictors)
dim(testPredictors)
length(trainIC50)
length(testIC50)
set.seed(seed)
lin_reg1 <- train(trainPredictors, trainIC50,
method = "lm",
trControl = fivefoldCV)
lin_reg1
#set.seed(seed)
#lin_reg2 <- train(trainPredictors, trainIC50,
#                 method = "lm",
#                 trControl = repeatedSplits)
#lin_reg2
set.seed(seed)
knn <- train(trainPredictors, trainIC50,
method = "kknn",
tuneGrid = data.frame(
kmax = seq(1, 21, by = 2),
distance = c(2),
kernel = c("rectangular")
),
preProcess = c("center", "scale", "pca"),
trControl = fivefoldCV)
knn
#set.seed(seed)
#knn2 <- train(trainPredictors, trainIC50,
#             method = "kknn",
#             tuneGrid = data.frame(
#             kmax = seq(2, 12, by = 2),
#             distance = 2,
#             kernel = "rectangular"
#             ),
#             preProcess = c("center", "scale", "pca"),
#             trControl = repeatedSplits)
#knn2
set.seed(seed)
SVM <- train(trainPredictors, trainIC50,
method = "svmRadial",
tuneLength = 5,
preProcess = c("center", "scale", "pca"),
trControl = fivefoldCV)
library(caret)
library(tidyverse)
library(kernlab)
library(dplyr)
library(tibble)
library(mlbench)
library(randomForest)
library(corrplot)
library(ggplot2)
